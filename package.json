{
  "name": "@fundus/depco",
  "version": "0.0.0",
  "type": "module",
  "description": "A UI tool to help you upgrade and track npm dependencies, vulnerabilities, licences, etc... in your projects.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./config": {
      "source": "./src/shared/config/index.ts",
      "default": "./dist/shared/config/index.js"
    }
  },
  "bin": "./dist/cli/index.js",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "author": {
    "email": "bruno.zoric@gmail.com",
    "name": "Bruno Zorić",
    "url": "https://github.com/brunozoric"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@gitbeaker/rest": "^43.8.0",
    "@inquirer/prompts": "^8.5.2",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@octokit/rest": "^22.0.1",
    "@webiny/di": "^1.0.2",
    "@webiny/stdlib": "^0.0.17",
    "@xyflow/react": "^12.11.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "bree": "^9.2.9",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "execa": "^10.0.1",
    "fastify": "^5.11.3",
    "fflate": "^0.8.3",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.7.1",
    "spdx-license-list": "^6.12.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "adio": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.11",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  },
  "imports": {
    "#api/*": {
      "source": "./src/api/*",
      "default": "./dist/api/*"
    },
    "#ui/*": {
      "source": "./src/ui/*",
      "default": "./dist/ui/*"
    },
    "#shared/*": {
      "source": "./src/shared/*",
      "default": "./dist/shared/*"
    },
    "#testing/*": {
      "source": "./src/testing/*",
      "default": "./src/testing/*"
    }
  },
  "scripts": {
    "drizzle-kit": "drizzle-kit",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "build": "tsc -b",
    "build:ui": "vite build",
    "dev:api": "node --conditions=source --import tsx src/api/server.ts",
    "dev:ui": "vite",
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:ui\"",
    "start": "node dist/api/server.js",
    "test": "vitest --config testing/vitest.config.ts --run",
    "test:coverage": "vitest --config testing/vitest.config.ts --run --coverage",
    "full": "yarn npm audit && yarn adio && yarn lint:fix && yarn format:fix && yarn build && yarn test"
  }
}
